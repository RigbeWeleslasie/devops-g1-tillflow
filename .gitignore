# --- Secrets / credentials (NEVER commit — Daraja sandbox keys, Slack webhook, DB creds) ---
*.env
.env
.env.*
!.env.example
*.pem
# Exception: Amazon's PUBLIC RDS root CAs -- a trust anchor, not a secret.
# It must be in the repo because the service images COPY it (see
# services/_shared/certs/README.md). The *.pem rule above still covers
# everything else, including private keys.
!services/_shared/certs/rds-ca.pem
*.key
credentials
aws.json
secrets/

# --- Terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl.bak
tfplan
*.tfplan

# --- Node / build ---
node_modules/
dist/
build/
coverage/
*.log
*.tsbuildinfo
.DS_Store

# --- Python (if any service uses it) ---
__pycache__/
*.pyc
.venv/
venv/

# --- k6 ---
k6/results/*.json
!k6/results/.gitkeep

# --- Local scratch ---
.scratch/
tmp/
