# Copy to .env for LOCAL DEV ONLY. .env is gitignored. Real values live in AWS
# Secrets Manager (devops-g1/daraja, devops-g1/service-token, devops-g1/slack-webhook,
# devops-g1/<service>/db, devops-g1/<service>/db-password).
# NEVER commit real credentials or real customer data. Daraja SANDBOX only.
#
# Not every service reads every variable — see each service's README for its own
# table. This file is the union, so one .env runs the whole stack locally.

# --- M-Pesa adapter ---
# `prod` REFUSES to start with `fake` (services/payments/src/config.ts).
MPESA_ADAPTER=fake            # fake | daraja
ENVIRONMENT=local             # local | dev | prod

# --- Daraja 3.0 sandbox (only needed when MPESA_ADAPTER=daraja) ---
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_B2C_SHORTCODE=600000
DARAJA_B2C_INITIATOR=testapi
DARAJA_B2C_SECURITY_CREDENTIAL=
DARAJA_TIMEOUT_MS=10000
# Public base URL Daraja posts callbacks to. Locally this is your tunnel;
# in prod it is the API Gateway URL, e.g. https://<api-gw>/payments
MPESA_CALLBACK_BASE_URL=http://localhost:8080

# --- Service-to-service auth ---
# One shared bearer token for POS's /internal/* and Payments' /charges and
# /payouts. Minimum 16 characters; the same value in all three services.
# Prod: devops-g1/service-token. threat-model.md §3.2.
SERVICE_TOKEN=local-dev-service-token-change-me

# --- Service URLs (how the services find each other) ---
POS_BASE_URL=http://localhost:8081
PAYMENTS_BASE_URL=http://localhost:8080

# --- Database (local) ---
# Each service connects as its own least-privilege role in prod
# (devops-g1-pos-app, devops-g1-payments-app). Commission shares the payments
# schema and role. ADMIN_DATABASE_URL is the RDS master, used ONLY by the
# migration scripts, never by a running service.
DATABASE_URL=postgres://tillflow:tillflow@localhost:5432/tillflow
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tillflow

# --- POS ---
JWT_SECRET=local-dev-jwt-secret-change-me

# --- Queues (unset locally: the fake adapter and in-process sources stand in) ---
# Payments publishes sale.paid here; POS consumes it.
SALE_EVENTS_QUEUE_URL=
# EventBridge posts the daily-close trigger here; Commission consumes it.
CLOSE_QUEUE_URL=
AWS_REGION=us-east-1

# --- Payments: reconciliation (I5) ---
# Past RECONCILE_MAX_ATTEMPTS a charge is surfaced for an alert and stays
# PENDING. Nothing here ever auto-fails a payment.
RECONCILE_AFTER_MS=120000
RECONCILE_INTERVAL_MS=300000
RECONCILE_MAX_ATTEMPTS=12
OUTBOX_INTERVAL_MS=1000

# --- POS runtime (local) ---
JWT_SECRET=dev-only-change-me
PAYMENTS_BASE_URL=http://localhost:8081
# Shared service-to-service token (Payments POST /charges requires X-Service-Token)
SERVICE_TOKEN=dev-service-token-change-me

# --- Redis (local) ---
REDIS_URL=redis://localhost:6379

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=pos
DEPLOYMENT_ENV=local

# --- Artifact identity (set by the pipeline, surfaced at /version) ---
COMMIT_SHA=
IMAGE_DIGEST=

# --- Alerts (local testing points at a throwaway webhook, NOT the real one) ---
SLACK_WEBHOOK_URL=
